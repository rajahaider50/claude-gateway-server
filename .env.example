# docker compose ke liye — copy to .env then fill values
#
# Generate:
#   openssl rand -hex 32        -> encryption / API key secret
#   openssl rand -base64 48     -> JWT secret

FREELLMAPI_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

OMNIROUTE_INITIAL_PASSWORD=replace-with-strong-password
OMNIROUTE_JWT_SECRET=replace-with-openssl-rand-base64-48
OMNIROUTE_API_KEY_SECRET=replace-with-openssl-rand-hex-32
